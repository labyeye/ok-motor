{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "env": {
    "PUBLIC_URL": "/software"
  },
  "rewrites": [
    {
      "source": "/software/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/software/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/software/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
