{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["assets/**/*"],
        "maxDuration": 60
      }
    }
  ],
  "routes": [{ "src": "/api/(.*)", "dest": "server.js" }],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  }
}
